{
  "manifest_version": 3,
  "name": "TextCapture 文字捕获",
  "version": "1.0.0",
  "description": "绕过网站的防复制限制（CSS 禁止选择 / JS 拦截复制事件），一键提取页面可见文本为 Markdown，支持复制与导出。",
  "permissions": ["sidePanel", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TextCapture 文字捕获",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["unlock.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
